 // Only entry points that go to a service are hooked; library functions that only read and write the game's own buffers (prepo Add / Array / Struct, err ErrorResultVariant, friends getters, socket byte-order conversion) keep running in the SDK.
 // Return convention as in hle_friends.c: Result returns RES_FAIL ("saved / submitted" kinds return RES_OK so the game does not retry); bool returns false; events get a bound SystemEvent that never fires.
 #include "hle.h"
+#include <stdlib.h>
+#include <stdatomic.h>
+#include "hle_lan_backend.h"
+
+static _Atomic(const dm_lan_backend *) g_lan_backend;
+int dm_lan_register_backend(const dm_lan_backend *b) {
+    if (!b || !b->initialize || !b->finalize || !b->state || !b->attach ||
+        !b->open_station || !b->close_station || !b->open_ap || !b->close_ap ||
+        !b->disconnect || !b->destroy || !b->scan || !b->create || !b->connect ||
+        !b->network_info || !b->ipv4 || !b->advertise) return -1;
+    const dm_lan_backend *empty = NULL;
+    return atomic_compare_exchange_strong(&g_lan_backend, &empty, b) ? 0 : -1;
+}
+#define LAN_BACKEND() atomic_load(&g_lan_backend)
+uint32_t dm_lan_ip_config(uint32_t *address,uint32_t *mask) {
+    const dm_lan_backend *b=LAN_BACKEND();uint32_t ip=0,netmask=0;
+    Result r=b?b->ipv4(&ip,&netmask):RES_FAIL;
+    if(address)*address=__builtin_bswap32(ip);if(mask)*mask=__builtin_bswap32(netmask);return r;
+}
+static _Atomic uint64_t g_lan_event_binding;
+void dm_lan_event_attach(void *event) {
+    atomic_store(&g_lan_event_binding, 0);
+    if (!event) return;
+    hle_bind_system_event(event, 1);
+    atomic_store(&g_lan_event_binding, hle_system_event_binding(event));
+}
+void dm_lan_event_signal(void) {
+    uint64_t binding = atomic_load(&g_lan_event_binding);
+    if (binding) (void)hle_signal_system_event_binding(binding);
+}
+void dm_lan_event_reset(void) { atomic_store(&g_lan_event_binding, 0); }
+
+/* Opt-in bring-up trace. Preserve the offline results until the LDN transport,
+ * event semantics and socket implementation are ready as one unit. */
+static void ldn_trace(const char *call) {
+    const char *enabled = getenv("DM_LDN_TRACE");
+    if (enabled && enabled[0] == '1' && enabled[1] == '\0') LOG("LDN trace: %s (offline)", call);
+}
 

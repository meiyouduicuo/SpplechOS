diff --git a/dm/host/hle_lan_backend.h b/dm/host/hle_lan_backend.h
new file mode 100644
index 0000000..564d9cf
--- /dev/null
+++ b/dm/host/hle_lan_backend.h
@@ -0,0 +1,77 @@
+/* Experimental backend seam for the LDN HLE. The owner must keep this table
+ * and its functions alive until the game framework has fully stopped. Calls
+ * may arrive concurrently on game threads. All members are mandatory: register
+ * only a complete backend, never a partially initialized implementation. */
+#pragma once
+#include <stdint.h>
+typedef struct dm_lan_backend {
+    uint32_t (*initialize)(void);
+    void (*finalize)(void);
+    int (*state)(void);
+    void (*attach)(void *event);
+    uint32_t (*open_station)(void);
+    uint32_t (*close_station)(void);
+    uint32_t (*open_ap)(void);
+    uint32_t (*close_ap)(void);
+    uint32_t (*disconnect)(void);
+    uint32_t (*destroy)(void);
+    uint32_t (*scan)(void *out, int *count, int max, const void *filter, int channel, int private_scan);
+    uint32_t (*create)(const void *config, const void *security, const void *user);
+    uint32_t (*connect)(const void *network, const void *security, const void *user, int version, int option);
+    uint32_t (*network_info)(void *out);
+    uint32_t (*ipv4)(uint32_t *address, uint32_t *mask);
+    uint32_t (*advertise)(const void *data, uint64_t size);
+    /* Optional until private-network support is supplied by the backend. */
+    uint32_t (*create_private)(const void *config,const void *security,const void *parameter,const void *user,int count,const void *addresses);
+    uint32_t (*connect_private)(const void *config,const void *security,const void *parameter,const void *user,int version,int option);
+    uint32_t (*network_config)(void *out);
+    uint32_t (*security_parameter)(void *out);
+    uint32_t (*policy)(int policy);
+    int (*disconnect_reason)(void);
+    uint32_t (*reject)(uint32_t address);
+} dm_lan_backend;
+/* Registration is single-shot before guest execution, not a hot-swap API. */
+int dm_lan_register_backend(const dm_lan_backend *backend);
+/* Attach from a guest thread; signal from any thread. The lifetime token
+ * prevents signalling a new event if the game's old event was destroyed. */
+void dm_lan_event_attach(void *event);
+void dm_lan_event_signal(void);
+void dm_lan_event_reset(void);
+/* Returns success only while the local virtual LDN link is connected. */
+uint32_t dm_lan_ip_config(uint32_t *address,uint32_t *mask);
+/* Reserve a descriptor in the same table as existing eventfds. A backend must
+ * stop all users before release; these functions do not implement poll. */
+int dm_net_reserve_fd(void);
+int dm_net_release_fd(int fd);
+/* Ready callback is called under the descriptor-table mutex and must be
+ * nonblocking, thread-safe and never call back into dm_net_*; return guest
+ * poll readiness bits (1 = readable, 4 = writable), or -1 if invalid.
+ * A backend must notify the table when readiness changes. */
+int dm_net_register_lan_ready(int (*ready)(int fd));
+void dm_net_notify_lan_ready(void);
+/* Socket backend takes raw guest sockaddr bytes and reports Horizon errno via
+ * error_out on failure. owns() must be safe against concurrent close. Table
+ * and implementation remain alive until all guest threads have stopped. */
+typedef struct dm_lan_socket_backend {
+    int (*owns)(int fd);
+    int (*socket)(int family, int type, int protocol, int *error_out);
+    int (*bind)(int fd, const void *address, unsigned size, int *error_out);
+    long (*sendto)(int fd, const void *data, unsigned long size, int flags, const void *address, unsigned address_size, int *error_out);
+    long (*recvfrom)(int fd, void *data, unsigned long size, int flags, void *address, unsigned *address_size, int *error_out);
+    int (*close)(int fd, int *error_out);
+    int (*getsockname)(int fd,void *address,unsigned *size,int *error_out);
+    int (*setsockopt)(int fd,int level,int option,const void *value,unsigned size,int *error_out);
+    int (*getsockopt)(int fd,int level,int option,void *value,unsigned *size,int *error_out);
+    int (*fcntl)(int fd,int command,uint64_t value,int *error_out);
+} dm_lan_socket_backend;
+int dm_net_register_lan_sockets(const dm_lan_socket_backend *backend);
+int dm_sk_socket(int family, int type, int protocol);
+int dm_sk_bind(int fd, const void *address, unsigned size);
+long dm_sk_sendto(int fd, const void *data, unsigned long size, int flags, const void *address, unsigned address_size);
+long dm_sk_recvfrom(int fd, void *data, unsigned long size, int flags, void *address, unsigned *address_size);
+int dm_sk_close(int fd);
+int dm_sk_last_errno(void);
+int dm_sk_getsockname(int fd,void *address,unsigned *size);
+int dm_sk_setsockopt(int fd,int level,int option,const void *value,unsigned size);
+int dm_sk_getsockopt(int fd,int level,int option,void *value,unsigned *size);
+int dm_sk_fcntl(int fd,int command,uint64_t value);
